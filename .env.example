# ==============================================
# B2B Tool Platform - Environment Variables
# ==============================================
# 이 파일에는 실제 값을 입력하지 않습니다.
# .env.local 파일을 생성하여 실제 값을 입력하세요.
# .env.local은 .gitignore에 포함되어 Git에 저장되지 않습니다.
# ==============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=

# Email (Resend or equivalent)
RESEND_API_KEY=

# Environment
NODE_ENV=development
